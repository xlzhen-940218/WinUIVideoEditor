<UserControl
    x:Class="WinUIVideoEditor.Controls.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinUIVideoEditor.Models"
    mc:Ignorable="d"
    Background="#18181C">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Left Corner: Controls & Zoom Slider -->
        <Border Grid.Row="0" Grid.Column="0" Background="#202026" BorderBrush="#2A2A32" BorderThickness="0,0,1,1">
            <Grid Padding="8,4">
                <TextBlock Text="时间线轨道" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#888899"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                    <Button x:Name="BtnZoomOut" Click="OnZoomOutClicked" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="缩小时间轴">
                        <FontIcon Glyph="&#xE738;" FontSize="10" Foreground="#AAAAAA"/>
                    </Button>
                    <Button x:Name="BtnZoomIn" Click="OnZoomInClicked" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="放大时间轴">
                        <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="#AAAAAA"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top Right: Time Ruler & Playhead Track Header -->
        <Border Grid.Row="0" Grid.Column="1" Background="#202026" BorderBrush="#2A2A32" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="RulerScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          ViewChanged="OnRulerScrollViewChanged">
                <Grid x:Name="RulerGrid" Height="36" HorizontalAlignment="Left">
                    <Canvas x:Name="RulerCanvas" Height="36" Background="Transparent"
                            PointerPressed="OnRulerPointerPressed"
                            PointerMoved="OnRulerPointerMoved"
                            PointerReleased="OnRulerPointerReleased"/>
                    <!-- Playhead Top Cursor Handle on Ruler -->
                    <Canvas x:Name="RulerPlayheadCanvas" IsHitTestVisible="False">
                        <Polygon x:Name="RulerPlayheadHead" Points="-6,0 6,0 6,18 0,26 -6,18" Fill="#FF4343" IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Bottom Left: Track Headers Column -->
        <Border Grid.Row="1" Grid.Column="0" Background="#1C1C22" BorderBrush="#2A2A32" BorderThickness="0,0,1,0">
            <StackPanel x:Name="TrackHeadersPanel" Spacing="2" Padding="0,4">
                <!-- Track 1: Video -->
                <Border Height="48" Background="#24242C" Padding="12,0" CornerRadius="4" Margin="4,2">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="#4CC2FF"/>
                            <TextBlock Text="视频主轨" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Track 2: Audio -->
                <Border Height="48" Background="#24242C" Padding="12,0" CornerRadius="4" Margin="4,2">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="#00E676"/>
                            <TextBlock Text="音频轨道" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Track 3: Text -->
                <Border Height="48" Background="#24242C" Padding="12,0" CornerRadius="4" Margin="4,2">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8D2;" FontSize="14" Foreground="#B180F0"/>
                            <TextBlock Text="文字字幕轨" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Track 4: Shape -->
                <Border Height="48" Background="#24242C" Padding="12,0" CornerRadius="4" Margin="4,2">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xEB42;" FontSize="14" Foreground="#FFA040"/>
                            <TextBlock Text="图形覆层轨" FontSize="12" FontWeight="SemiBold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Bottom Right: Tracks Content & Scrubber Grid -->
        <Border Grid.Row="1" Grid.Column="1" Background="#141418">
            <ScrollViewer x:Name="TracksScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ViewChanged="OnTracksScrollViewChanged">
                <Grid x:Name="TracksGrid" HorizontalAlignment="Left"
                      PointerPressed="OnTracksGridPointerPressed">
                    <!-- Tracks Canvas Stack -->
                    <StackPanel HorizontalAlignment="Left" Spacing="2" Padding="0,4">
                        <!-- Video Track Row -->
                        <Canvas x:Name="VideoTrackCanvas" Height="48" HorizontalAlignment="Left" Background="#1E1E24" Margin="0,2"/>
                        <!-- Audio Track Row -->
                        <Canvas x:Name="AudioTrackCanvas" Height="48" HorizontalAlignment="Left" Background="#1E1E24" Margin="0,2"/>
                        <!-- Text Track Row -->
                        <Canvas x:Name="TextTrackCanvas" Height="48" HorizontalAlignment="Left" Background="#1E1E24" Margin="0,2"/>
                        <!-- Shape Track Row -->
                        <Canvas x:Name="ShapeTrackCanvas" Height="48" HorizontalAlignment="Left" Background="#1E1E24" Margin="0,2"/>
                    </StackPanel>

                    <!-- Playhead Vertical Line traversing tracks -->
                    <Canvas x:Name="PlayheadOverlayCanvas" IsHitTestVisible="False">
                        <Border x:Name="PlayheadLine" Width="2" Background="#FF4343" IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
